# Base URL the frontend uses for API calls.
# Keep as /api to use the Vite dev proxy (see vite.config.js); point it at an
# absolute URL if the API is served from a different origin in production.
VITE_API_BASE_URL=/api

# Backend origin the Vite dev server proxies /api requests to.
VITE_BACKEND_URL=http://localhost:8000
